<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ice Cream Flavors</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f8f8f8;
        text-align: center;
        margin: 0;
        padding: 20px;
    }

    h1 {
        color: #333;
    }

    .container {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        width: 250px;
        padding: 15px;
        transition: transform 0.3s;
    }

    .card:hover {
        transform: scale(1.05);
    }

    .card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
        border-radius: 10px;
    }

    button {
        padding: 10px 15px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        color: white;
        font-size: 16px;
        margin-top: 10px;
    }

    .strawberry-btn {
        background-color: #ff4d88;
    }

    .chocolate-btn {
        background-color: #6b3e26;
    }

    .ube-btn {
        background-color: #8a2be2;
    }

    #info {
        margin-top: 30px;
        padding: 15px;
        background: white;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        font-size: 18px;
    }
</style>
</head>
<body>

<h1>🍦 Ice Cream Flavors</h1>

<div class="container">

    
<div class="card">
    <img src="https://www.adashofmegnut.com/wp-content/uploads/2022/09/Strawberry-Ice-Cream-1.jpg"
    alt="Strawberry Ice Cream">
    <h2>🍓 Strawberry</h2>
    <button class="strawberry-btn" onclick="showFlavor('strawberry')">
        Learn More
    </button>
</div>

<div class="card">
    <img src="https://images.unsplash.com/photo-1563805042-7684c019e1cb?w=500"
         alt="Chocolate Ice Cream">
    <h2>🍫 Chocolate</h2>
    <button class="chocolate-btn" onclick="showFlavor('chocolate')">
        Learn More
    </button>
</div>

<div class="card">
    <img src="https://www.cooking-therapy.com/wp-content/uploads/2021/06/Ube-Ice-Cream-3.jpg"
         alt="Ube Ice Cream">
    <h2>💜 Ube</h2>
    <button class="ube-btn" onclick="showFlavor('ube')">
        Learn More
    </button>
</div>

</div>

<div id="info">
    Click "Learn More" to discover your favorite flavor!
</div>

<script>
function showFlavor(flavor) {
    let description = "";

    switch(flavor) {
        case "strawberry":
            description =
            "🍓 Strawberry Ice Cream is sweet, creamy, and packed with delicious strawberry flavor.";
            break;

        case "chocolate":
            description =
            "🍫 Chocolate Ice Cream is rich, smooth, and a favorite among chocolate lovers.";
            break;

        case "ube":
            description =
            "💜 Ube Ice Cream is a popular Filipino dessert made from purple yam with a uniquely sweet and nutty taste.";
            break;
    }

    document.getElementById("info").innerHTML = description;
}
</script>

</body>
</html>
